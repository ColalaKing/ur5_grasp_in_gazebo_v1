<?xml version="1.0"?>
<launch>
  <arg name="limited" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="gui" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="sim" default="true"/>
  <arg name="randomize" default="true"/>
  <arg name="seed" default="0"/>
  <arg name="spawn_obstacles" default="false"/>
  <arg name="scene_config" default="$(find ur5_notebook)/config/assignment_scene.yaml"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find ur5_notebook)/launch/initialize.world"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <include file="$(find ur_description)/launch/ur5_upload.launch">
    <arg name="limited" value="$(arg limited)"/>
  </include>

  <node name="spawn_gazebo_model" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model robot -z 0.2 -y 0.7"
        respawn="false" output="screen"/>

  <include file="$(find ur_gazebo)/launch/controller_utils.launch"/>

  <rosparam file="$(find ur_gazebo)/controller/arm_controller_ur5.yaml" command="load"/>
  <node name="arm_controller_spawner" pkg="controller_manager" type="controller_manager"
        args="spawn arm_controller" respawn="false" output="screen"/>

  <remap if="$(arg sim)" from="/follow_joint_trajectory" to="/arm_controller/follow_joint_trajectory"/>

  <include file="$(find ur5_moveit_config)/launch/move_group.launch">
    <arg name="limited" default="$(arg limited)"/>
    <arg name="debug" default="$(arg debug)"/>
  </include>

  <node name="scene_spawner" pkg="ur5_notebook" type="scene_spawner"
        launch-prefix="$(find ur5_notebook)/scripts/delayed_exec.sh 5"
        output="screen">
    <rosparam command="load" file="$(arg scene_config)"/>
    <param name="randomize" value="$(arg randomize)"/>
    <param name="seed" value="$(arg seed)"/>
    <param name="spawn_obstacles" value="$(arg spawn_obstacles)"/>
  </node>
</launch>
